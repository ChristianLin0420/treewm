      "agent": {"alpha": 1.0, "expectile": 0.7, "ensemble_ct": 10, "rho": 0.5, "h": 5, "discount": 0.99, "batch_size": 256}
    },
    {
      "id": "puzzle-4x4-100m",
      "env_template": "puzzle-4x4-play-singletask-task{task_id}-v0",
      "sparse": true,
      "dataset": {
        "kind": "sharded_100m",
        "name": "puzzle-4x4-play-100m-v0",
        "file_stem": "puzzle-4x4-play-v0",
        "directory": "puzzle-4x4-play-100m-v0",
        "expected_train_shards": 100,
        "expected_validation_shards": 100,
        "replace_interval": 1000
