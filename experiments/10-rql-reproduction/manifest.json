{
  "schema_version": 1,
  "campaign_id": "rql-50task-1m-array-v2",
  "description": "RQL formal protocol: 10 settings x 5 single-task goals x 4 seeds x exactly 1M updates",
  "expected_run_count": 200,
  "axes": {
    "task_ids": [1, 2, 3, 4, 5],
    "seeds": [0, 1, 2, 3]
  },
  "execution": {
    "workers": 16,
    "allocation_shards": 13,
    "gpus_per_worker": 1,
    "assignment": "manifest_index_equals_allocation_shard_times_workers_plus_rank"
  },
  "training": {
    "offline_steps": 1000000,
    "online_steps": 0,
    "eval_episodes": 50,
    "final_eval_episodes": 50,
    "eval_interval": 100000,
    "log_interval": 5000,
    "save_interval": 1000000,
    "checkpoint_interval": 50000,
    "walltime_seconds": 13800,
    "gradient_checkpointing": true
  },
  "logging": {
    "wandb_project": "rql-reproduction",
    "wandb_group": "rql-50task-1m-array",
    "resume": "allow"
  },
  "data": {
    "base_url": "https://rail.eecs.berkeley.edu/datasets/ogbench",
    "standard_subdir": "standard",
    "large_subdir": "100m"
  },
  "upstream": {
    "repository": "https://github.com/aoberai/rql",
    "commit": "229c956efb4494c2b9bb0bbddbd67b761c93f1cc"
  },
  "settings": [
    {
      "id": "scene",
      "env_template": "scene-play-singletask-task{task_id}-v0",
      "sparse": true,
      "dataset": {"kind": "standard", "name": "scene-play-v0"},
      "agent": {"alpha": 3.0, "expectile": 0.7, "ensemble_ct": 10, "rho": 0.5, "h": 5, "discount": 0.99, "batch_size": 256}
    },
    {
      "id": "puzzle-3x3",
      "env_template": "puzzle-3x3-play-singletask-task{task_id}-v0",
      "sparse": true,
